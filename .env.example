   NODE_ENV=development
   PORT=5000

   MYSQL_HOST=localhost
   MYSQL_PORT=3306
   MYSQL_USER=root
   MYSQL_PASSWORD=your_mysql_password
   MYSQL_DATABASE=project_task_db

   MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/project_task_db?retryWrites=true&w=majority

   JWT_SECRET=replace_this_with_a_random_string_of_at_least_32_characters
   JWT_EXPIRES_IN=1d

   BCRYPT_SALT_ROUNDS=12

   CORS_ORIGIN=*

   RATE_LIMIT_WINDOW_MS=900000
   RATE_LIMIT_MAX=300
   AUTH_RATE_LIMIT_MAX=30